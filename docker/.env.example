# copy to .env
NOVNC_USER=tmnf
NOVNC_PASSWORD=change-me
# gids on the host: getent group render video
RENDER_GID=992
VIDEO_GID=44
# where datasets go (bind-mounted at /out)
TMNF_OUT=./data/out
# NAS folder mounted at /tmnf-ml (train_replays/, train_data/)
SMB_HOST=10.0.0.100
SMB_DEVICE=//10.0.0.100/app_storage/tmnf-ml
SMB_USER=backup
SMB_PASSWORD=change-me
