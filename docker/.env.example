# copy to .env
NOVNC_USER=tmnf
NOVNC_PASSWORD=change-me
# gids on the host: getent group render video
RENDER_GID=992
VIDEO_GID=44
# where datasets go (bind-mounted at /out)
TMNF_OUT=./data/out
# SMB share mounted at /tmnf-ml (train_replays/, train_data/)
SMB_HOST=nas.local
SMB_DEVICE=//nas.local/share/tmnf-ml
SMB_USER=tmnf
SMB_PASSWORD=change-me
