# Headless desktop for the game instances and the noVNC console.
# The collector tiles its game windows (one 800x600 Wine desktop each, four
# to a row) on this output, so it is sized for eight of them plus the bar.
output HEADLESS-1 resolution 3200x1240 position 0 0
xwayland enable

# Every window floats, unframed, where it was asked to be; a tiling layout
# would resize the 640x480 game viewports.
for_window [app_id=".*"] floating enable, border none
for_window [class=".*"] floating enable, border none
default_border none
default_floating_border none
focus_follows_mouse no
# The game calls SetForegroundWindow to arm each run; that is settled inside
# its own Wine desktop, and must not move focus between instances here.
focus_on_window_activation urgent
seat * hide_cursor 0

font pango:DejaVu Sans 10
bar {
    position bottom
    status_command while date +'%Y-%m-%d %H:%M:%S'; do sleep 1; done
}

set $mod Mod4
bindsym $mod+Return exec foot
bindsym $mod+t exec tmnf-launch tmloader
bindsym $mod+q kill
bindsym $mod+Shift+e exit
floating_modifier $mod normal
